TRANSMISSION_USER=change-me
TRANSMISSION_PASS=change-me
TRANSMISSION_CONFIG_PATH=/path/to/transmission/config
TRANSMISSION_DATA_PATH=/path/to/downloads

# Use the PIA OpenVPN credentials shown in your PIA account, which can differ
# from the credentials used to sign in to the PIA website.
PIA_USER=p0000000
PIA_PASS=change-me
# Example: choose the closest available region for the best performance.
PIA_REGION=Netherlands
